# Copie estas variables en Netlify: Site configuration > Environment variables.
# NUNCA las suba al repositorio.

# --- ONVO Pay (https://dashboard.onvopay.com) ---
# Modo pruebas: llaves onvo_test_...   Modo real: onvo_live_...
ONVO_SECRET_KEY=
ONVO_PUBLIC_KEY=

# --- Tilopay (https://admin.tilopay.com > Tilopay Checkout) ---
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
# TILOPAY_DEFAULT_ZIP=10101

# URL pública del sitio (si no se define, Netlify usa la suya).
# SITE_URL=https://mundoonlinecr.com
